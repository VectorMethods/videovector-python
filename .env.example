# Copy to .env for local experimentation. Never commit real values.
VIDEO_VECTOR_API_KEY=<VIDEO_VECTOR_API_KEY>
# Static short-lived OAuth access token or Firebase ID token. Long-lived OAuth
# clients should use the constructor's oauth_token_provider instead.
VIDEO_VECTOR_BEARER_TOKEN=<VIDEO_VECTOR_BEARER_TOKEN>
VIDEO_VECTOR_AUTH_MODE=api_key
VIDEO_VECTOR_BASE_URL=https://api.vectormethods.com/api/v2
VIDEO_VECTOR_TIMEOUT=60
VIDEO_VECTOR_MAX_RETRIES=3

# Common example inputs
VIDEO_VECTOR_INDEX_ID=idx_example
VIDEO_VECTOR_VIDEO_ID=vid_example
VIDEO_VECTOR_PROMPT_ID=prompt_example
VIDEO_VECTOR_RUN_ID=run_example
VIDEO_VECTOR_MEDIA_FILE=/path/to/video.mp4
VIDEO_VECTOR_IMAGE_FILE=/path/to/query-image.jpg

# Connector examples
VIDEO_VECTOR_S3_BUCKET=example-media-bucket
VIDEO_VECTOR_S3_REGION=us-east-1
VIDEO_VECTOR_AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID>
VIDEO_VECTOR_AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>
VIDEO_VECTOR_GCS_BUCKET=example-media-bucket
VIDEO_VECTOR_GCP_PROJECT_ID=example-project
VIDEO_VECTOR_GCS_CREDENTIALS_FILE=/path/to/service-account.json
VIDEO_VECTOR_AZURE_STORAGE_ACCOUNT=exampleaccount
VIDEO_VECTOR_AZURE_CONTAINER=media
VIDEO_VECTOR_AZURE_TENANT_ID=<AZURE_TENANT_ID>
VIDEO_VECTOR_AZURE_CLIENT_ID=<AZURE_CLIENT_ID>
VIDEO_VECTOR_AZURE_CLIENT_SECRET=<AZURE_CLIENT_SECRET>
